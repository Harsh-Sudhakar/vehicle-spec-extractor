# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model id. Must support JSON output.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional overrides
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# DATA_DIR=data
# ENABLE_OCR=false
# MAX_UPLOAD_MB=20
# RATE_LIMIT_PER_MIN=20
# USE_RERANKER=true          # set false on 512 MB hosts
# ALLOW_UPLOAD=true
# Web uploads are private to the uploading browser; limits below keep indexing within 512 MB
# MAX_UPLOAD_PAGES=150        # 0 = no limit (CLI / data/ manuals are never limited)
# MAX_UPLOADS_PER_VISITOR=2
# UPLOAD_TTL_HOURS=6
# EMBED_BATCH_SIZE=1
# Hosted demo: prebuilt indexes in a private Hugging Face dataset
# HF_DATA_REPO=your-name/specx-demo-data
# HF_TOKEN=
# Manual (filename or doc_id) the UI opens with, and the question it runs on load
# DEFAULT_DOC=f150-workshop-manual.pdf
# DEFAULT_QUERY=Torque for brake caliper bolts
